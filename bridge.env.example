# Copy to bridge.env and fill in values

# ntfy server (default: public ntfy.sh)
NTFY_BASE=https://ntfy.sh

# Topic name — make it hard to guess (e.g. a random string like "mybridge-a3f9k2m7")
# Server and client must use the SAME value
BRIDGE_TOPIC=mybridge-CHANGE_THIS

# Shared secret — jobs without this token are rejected by the server
# Leave empty to disable auth (not recommended on public ntfy.sh)
BRIDGE_TOKEN=supersecret-CHANGE_THIS
